# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./digital_twin_ai.db
# For PostgreSQL (Docker):
# DATABASE_URL=postgresql://dtai:dtai_pass@postgres:5432/digital_twin_ai

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-256-bit-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://127.0.0.1:8501,http://localhost:8501

# ── AI / LLM ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-openai-key-here...
OPENAI_MODEL=gpt-4o
# Max tokens for AI responses
OPENAI_MAX_TOKENS=800
# Temperature (0.0 = deterministic, 1.0 = creative)
OPENAI_TEMPERATURE=0.3

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max assistant messages per user per hour
RATE_LIMIT_MESSAGES_PER_HOUR=30
# Redis URL (set to use Redis; leave empty to use in-memory fallback)
REDIS_URL=

# ── Reports ───────────────────────────────────────────────────────────────────
# Directory where generated PDFs are temporarily stored
REPORTS_DIR=./reports

# ── Frontend ──────────────────────────────────────────────────────────────────
API_BASE_URL=http://127.0.0.1:8000
